{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": ".build"
  },
  "include": [
    "src/**/*.ts"
  ]
}
